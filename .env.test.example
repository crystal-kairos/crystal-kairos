# ==============================================================================
# Crystal Kairos — Test Environment Configuration Example
# ==============================================================================
#
# Copy this file to `.env.test` (which is git-ignored) for running local
# database-backed integration tests.
#
# IMPORTANT:
# - Never point `TEST_DATABASE_URL` or `DATABASE_URL` in tests at a shared,
#   staging, or production database.
# - Unit tests (`tests/unit/**`) do NOT require a database or external API keys.
#
# Creating and resetting a local test database (without touching dev/shared DB):
#   1. Create an isolated local PostgreSQL database:
#      createdb crystal_kairos_test
#   2. Apply migrations to the test database only:
#      DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crystal_kairos_test?schema=public" pnpm prisma migrate deploy
#   3. Reset the local test database if needed:
#      DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crystal_kairos_test?schema=public" pnpm prisma migrate reset --force --skip-seed
# ==============================================================================

NODE_ENV="test"
TZ="Africa/Lagos"

# Dedicated local PostgreSQL test database (never use a shared database)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crystal_kairos_test?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crystal_kairos_test?schema=public"

# Auth.js test secret (deterministic dummy value for local tests only)
AUTH_SECRET="test-only-auth-secret-do-not-use-in-production-0000000000"
NEXTAUTH_URL="http://localhost:3000"
