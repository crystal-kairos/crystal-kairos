generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

enum Relationship {
  SPOUSE
  SIBLING
  PARENT
  CHILD
  FRIEND
  COLLEAGUE
  NEIGHBOR
  ACQUAINTANCE
  RELATIVE
  EMPLOYER
  EMPLOYEE
  OTHER
}

enum MembershipInterest {
  E_AJO
  SAVINGS
  LOAN
}

enum Assumptions {
  HAS_SMART_PHONE
  HAS_INTEGRITY
  IS_TRUSTWORTHY
  HAS_INTERNET_ACCESS
  HAS_EMAIL
  HAS_WHATS_APP
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED // For yearly renewal tracking
}

enum MembershipTier {
  MEMBER // Loan only
  SILVER_MEMBER // Ajo participant
  GOLD_MEMBER // Savings participant
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationEventType {
  // System-triggered
  MEMBER_REGISTERED
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  MEMBERSHIP_EXPIRED
  PASSWORD_SET
  // Admin-triggered
  CUSTOM
}

// E-AJO ENUMS
enum EAjoDuration {
  FOUR_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum EAjoFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum EAjoStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EAjoMemberStatus {
  PENDING // Member applied, awaiting admin approval
  APPROVED // Admin approved the slot assignment
  REJECTED // Admin rejected the application
  ACTIVE // Group is running and member is contributing
  COMPLETED // Member received their payout
  CANCELLED // Member or admin cancelled
}

// SAVINGS ENUMS
enum SavingsType {
  FIXED // UPFRONT - bulk amount once
  REGULAR // Regular interval savings
  STAGGERED // Any amount, any time
}

enum SavingsFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ONCE // For FIXED savings
}

enum SavingsMaturity {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum SavingsStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  MATURED
  WITHDRAWN
  EARLY_WITHDRAWAL // Withdrawn before maturity (no interest)
}

// LOAN ENUMS
enum LoanStatus {
  PENDING
  APPROVED
  ACCEPTED
  DECLINED
  REJECTED
  DISBURSED
  ACTIVE
  COMPLETED
  DEFAULTED
  OVERDUE
}

// enum LoanApplicantType {
//   MEMBER_WITH_SAVINGS
//   MEMBER_WITHOUT_SAVINGS
//   NON_MEMBER
// }

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST_CREDIT
  PENALTY
  FEE_DEDUCTION
  REFUND
}

// ============================================
// CORE USER MODELS
// ============================================
model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  username               String         @unique @default(uuid())
  name                   String
  passwordHash           String? // Optional: null until user sets password
  photoUrl               String?
  role                   UserRole       @default(USER)
  emailVerified          DateTime? // For email verification
  hasSetPassword         Boolean        @default(false) // Track if user has activated account
  lastLoginAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  receivedNotifications  Notification[] @relation("ReceivedNotifications")
  triggeredNotifications Notification[] @relation("TriggeredNotifications")

  // Relations
  accounts               Account[]
  sessions               Session[]
  userInfo               UserInfo?
  bankAccounts           BankAccount[]
  nextOfKin              NextOfKin?
  membership             Membership?
  eAjo                   EAjo[]
  eAjoGroups             EAjoGroup[]      @relation("EAjoGroupCreator")
  eAjoMembers            EAjoMember[]
  savings                Savings[]
  loans                  Loan[]
  transactions           Transaction[]    @relation("TransactionOwner")
  transactionsRecorded   Transaction[]    @relation("TransactionRecorder")
  transactionsProcessed  Transaction[]    @relation("TransactionProcessor")
  createdSavingsProducts SavingsProduct[] @relation("SavingsProductCreator")

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserInfo {
  id          String    @id @default(uuid())
  address     String?
  dateOfBirth DateTime?
  gender      Gender?
  occupation  String?
  phoneNumber String?
  userId      String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_info")
}

model BankAccount {
  id            String        @id @default(uuid())
  accountNumber String
  accountName   String
  bankName      String
  userId        String
  isPrimary     Boolean       @default(false) // Mark primary account
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@map("bank_accounts")
}

model NextOfKin {
  id            String       @id @default(uuid())
  name          String
  phoneNumber   String
  relationship  Relationship
  bankName      String
  accountNumber String
  accountName   String
  occupation    String
  address       String
  userId        String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("next_of_kins")
}

model Membership {
  id                  String               @id @default(uuid())
  sourceOfIncome      String[]
  interests           MembershipInterest[]
  referralName        String?
  referralPhoneNumber String?
  membershipNumber    String?              @unique
  assumptions         Assumptions[]
  tier                MembershipTier       @default(MEMBER)
  status              MembershipStatus     @default(PENDING)
  approvedAt          DateTime?
  approvedBy          String?
  rejectionReason     String?
  membershipFee       Decimal              @default(0) // Currently 0, future: 5000
  renewalFee          Decimal              @default(0) // Currently 0, future: 2000
  expiryDate          DateTime? // For yearly renewal
  lastRenewalDate     DateTime?
  userId              String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "welcome_email"
  subject     String
  htmlBody    String // HTML with {{variable}} placeholders
  variables   String[] // list of variable names e.g. ["memberName", "date"]
  description String?
  isSystem    Boolean  @default(false) // system templates can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications Notification[]

  @@map("notification_templates")
}

model Notification {
  id      String                @id @default(uuid())
  type    NotificationEventType
  channel NotificationChannel
  status  NotificationStatus    @default(PENDING)

  // Who sent it
  triggeredBy String? // userId of admin, null = system

  // Who receives it
  recipientId String // userId

  // Content
  subject    String?
  body       String // final rendered HTML or text
  templateId String?
  variables  Json? // snapshot of variables used

  // Metadata
  externalId  String? // e.g. Resend message ID
  errorMsg    String?
  readAt      DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User                  @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  triggerer User?                 @relation("TriggeredNotifications", fields: [triggeredBy], references: [id])
  template  NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@map("notifications")
}

// ============================================
// E-AJO (CONTRIBUTION) MODELS
// ============================================

model EAjo {
  id                   String        @id @default(uuid())
  userId               String
  contributionAmount   Decimal // Amount to save per period (e.g., 10k)
  totalParticipants    Int // Duration in months (4, 6, or 12)
  duration             EAjoDuration
  frequency            EAjoFrequency
  payoutPosition       Int // Which position user wants to collect (1-4, 1-6, or 1-12)
  feePercentage        Decimal // Calculated based on position and duration
  feeAmount            Decimal // Actual fee to be deducted
  totalExpectedPayout  Decimal // contributionAmount * totalParticipants
  netPayoutAmount      Decimal // totalExpectedPayout - feeAmount
  guarantorName        String
  guarantorPhoneNumber String
  bankName             String
  accountNumber        String
  accountName          String
  currentBalance       Decimal       @default(0)
  totalContributed     Decimal       @default(0)
  hasReceivedPayout    Boolean       @default(false)
  payoutDate           DateTime?
  startDate            DateTime?
  endDate              DateTime?
  isAnonymousRequest   Boolean       @default(false) // True if submitted via public form with membership ID
  status               EAjoStatus    @default(PENDING)
  approvedAt           DateTime?
  approvedBy           String?
  rejectionReason      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("e_ajo")
}

// ============================================
// E-AJO GROUP MODELS (Admin-Created)
// ============================================

model EAjoGroup {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  contributionAmount Decimal       @db.Decimal(15, 2)
  frequency          EAjoFrequency
  duration           EAjoDuration
  totalSlots         Int // Number of positions (4, 6, or 12)
  filledSlots        Int           @default(0)
  status             EAjoStatus    @default(PENDING)
  startDate          DateTime?
  endDate            DateTime?
  createdBy          String // Admin User ID
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  createdByUser User         @relation("EAjoGroupCreator", fields: [createdBy], references: [id])
  members       EAjoMember[]

  @@index([status])
  @@map("e_ajo_groups")
}

model EAjoMember {
  id                   String           @id @default(uuid())
  groupId              String
  userId               String
  payoutPosition       Int // Requested/assigned slot number (1 to totalSlots)
  feePercentage        Decimal          @default(0) @db.Decimal(5, 2)
  feeAmount            Decimal          @default(0) @db.Decimal(15, 2)
  totalExpectedPayout  Decimal          @default(0) @db.Decimal(15, 2)
  netPayoutAmount      Decimal          @default(0) @db.Decimal(15, 2)
  guarantorName        String
  guarantorPhoneNumber String
  bankName             String
  accountNumber        String
  accountName          String
  currentBalance       Decimal          @default(0) @db.Decimal(15, 2)
  totalContributed     Decimal          @default(0) @db.Decimal(15, 2)
  hasReceivedPayout    Boolean          @default(false)
  payoutDate           DateTime?
  status               EAjoMemberStatus @default(PENDING)
  approvedAt           DateTime?
  approvedBy           String? // Admin User ID
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  group        EAjoGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([groupId, payoutPosition]) // One member per slot per group
  @@unique([groupId, userId]) // One application per user per group
  @@index([userId])
  @@index([groupId])
  @@map("e_ajo_members")
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
  DISBURSED
  FAILED
}

enum TransactionCategory {
  AJO_CONTRIBUTION
  AJO_PAYOUT
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  WALLET_TOPUP
  WALLET_WITHDRAWAL
  INTEREST
  PENALTY
  FEE
}

model AjoFeeConfig {
  id             String   @id @default(uuid())
  durationMonths Int // 4, 6, 12
  pickPosition   Int // 1 to N
  feePercentage  Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([durationMonths, pickPosition])
  @@map("ajo_fee_configs")
}

model Transaction {
  id       String              @id @default(uuid())
  userId   String
  amount   Decimal             @db.Decimal(15, 2)
  category TransactionCategory
  type     TransactionType
  status   TransactionStatus   @default(PENDING)

  // Reference IDs to specific packages
  eAjoId       String?
  eAjoMemberId String? // Reference to new EAjoMember model
  savingsId    String?
  loanId       String?

  // Offline/Manual payment tracking
  receiptUrl      String?
  rejectionReason String?
  referenceNumber String?
  notes           String?

  // Account routing (for money-out)
  bankAccountId String?

  // Audit metadata
  recordedBy  String // User ID who uploaded/recorded (usually owner or admin)
  processedBy String? // User ID of admin who approved/confirmed/disbursed

  transactionDate DateTime  @default(now())
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  recorder    User         @relation("TransactionRecorder", fields: [recordedBy], references: [id])
  processor   User?        @relation("TransactionProcessor", fields: [processedBy], references: [id])
  eAjo        EAjo?        @relation(fields: [eAjoId], references: [id], onDelete: SetNull)
  eAjoMember  EAjoMember?  @relation(fields: [eAjoMemberId], references: [id], onDelete: SetNull)
  savings     Savings?     @relation(fields: [savingsId], references: [id], onDelete: SetNull)
  loan        Loan?        @relation(fields: [loanId], references: [id], onDelete: SetNull)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("transactions")
}

// ============================================
// SAVINGS MODELS
// ============================================

model SavingsProduct {
  id                   String      @id @default(uuid())
  type                 SavingsType // (FIXED, REGULAR, STAGGERED)
  title                String
  description          String
  rates                String // e.g. "12% (6 Months) / 36% (1 Year)"
  badge                String // e.g. "High Yield"
  icon                 String // Name of the lucide icon, e.g. "Lock", "PiggyBank"
  interestRate1Month   Decimal?
  interestRate3Months  Decimal?
  interestRate6Months  Decimal?
  interestRate12Months Decimal?
  isActive             Boolean     @default(true)
  createdBy            String // Admin userId
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdByUser User      @relation("SavingsProductCreator", fields: [createdBy], references: [id])
  savings       Savings[]

  @@map("savings_products")
}

model Savings {
  id                     String           @id @default(uuid())
  userId                 String
  productId              String?
  savingsType            SavingsType
  targetAmount           Decimal? // For FIXED, the bulk amount; For REGULAR, amount per period
  frequency              SavingsFrequency
  maturity               SavingsMaturity
  interestRate           Decimal // 12% or 36% for FIXED; 4.5% or 10.5% for REGULAR
  bankName               String
  accountNumber          String
  accountName            String
  currentBalance         Decimal          @default(0)
  accruedInterest        Decimal          @default(0)
  totalDeposited         Decimal          @default(0)
  expectedMaturityAmount Decimal?
  isAnonymousRequest     Boolean          @default(false) // True if submitted via public form with membership ID
  status                 SavingsStatus    @default(PENDING)
  approvedAt             DateTime?
  approvedBy             String?
  rejectionReason        String?
  startDate              DateTime?
  maturityDate           DateTime?
  earlyWithdrawal        Boolean          @default(false) // If true, no interest
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      SavingsProduct? @relation(fields: [productId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@index([productId])
  @@map("savings")
}

// Deprecated savings transactions removed

// ============================================
// LOAN MODELS
// ============================================

model Loan {
  id                   String     @id @default(uuid())
  userId               String
  // applicantType        LoanApplicantType
  requestedAmount      Decimal
  approvedAmount       Decimal?
  interestRate         Decimal // 0%, 3.5%, 5%, or 10% per month based on type
  duration             Int // In months (max 6)
  purpose              String
  guarantorId          String? // Another User ID (must be Crystal member)
  guarantorName        String?
  guarantorPhoneNumber String?
  collateralDetails    String? // For non-members
  applicationFee       Decimal    @default(0) // 0, 500, or 2000
  outstandingBalance   Decimal    @default(0)
  totalRepaid          Decimal    @default(0)
  defaultPenalty       Decimal    @default(0) // 10% on defaulted periods
  gracePeriodDays      Int        @default(7)
  isAnonymousRequest   Boolean    @default(false) // True if submitted via public form with membership ID
  status               LoanStatus @default(PENDING)
  requestedAt          DateTime   @default(now())
  approvedAt           DateTime?
  approvedBy           String?
  disbursedAt          DateTime?
  repaymentStartDate   DateTime?
  repaymentEndDate     DateTime?
  actualRepaymentDate  DateTime?
  rejectionReason      String?
  isDefaulted          Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // guarantor  User?            @relation("LoanGuarantor", fields: [guarantorId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([guarantorId])
  @@index([status])
  @@map("loans")
}

model LoanSettings {
  id           String   @id @default("global") // singleton
  interestRate Decimal  @default(5.0) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}
