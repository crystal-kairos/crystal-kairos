enum LedgerAccountType {
  COOPERATIVE_CASH
  SUSPENSE_UNIDENTIFIED
  MEMBER_WALLET_LIABILITY
  SAVINGS_PRINCIPAL_LIABILITY
  SAVINGS_INTEREST_PAYABLE
  SAVINGS_INTEREST_EXPENSE
  LOAN_RECEIVABLE_PRINCIPAL
  LOAN_INTEREST_RECEIVABLE
  LOAN_INTEREST_INCOME
  LOAN_PENALTY_RECEIVABLE
  EAJO_CONTRIBUTION_LIABILITY
  EAJO_ADVANCE_RECEIVABLE
  EAJO_PENALTY_RECEIVABLE
  EAJO_EARLY_SLOT_INCOME
  PENALTY_INCOME
  FEE_INCOME
  WAIVER_EXPENSE
  BAD_DEBT_EXPENSE
  MEMBER_SETTLEMENT_PAYABLE
  REVERSAL_SHORTFALL_RECEIVABLE
  OPENING_BALANCE_EQUITY
  ADJUSTMENT
}

enum WalletWithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
  FAILED
}

model JournalEntry {
  id             String   @id @default(uuid())
  sourceType     String // e.g. TRANSACTION, PAYMENT, DISBURSEMENT, RECOVERY, ACCRUAL
  sourceId       String
  idempotencyKey String   @unique
  description    String
  effectiveDate  DateTime @db.Date
  postedAt       DateTime @default(now())
  postedById     String?
  reversalOfId   String?  @unique
  reason         String?
  createdAt      DateTime @default(now())

  postedBy           User?               @relation("JournalEntryPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reversalOf         JournalEntry?       @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         JournalEntry?       @relation("JournalReversal")
  lines              JournalLine[]
  paymentAllocations PaymentAllocation[]
  disbursements      Disbursement[]

  @@index([sourceType, sourceId])
  @@index([effectiveDate])
  @@index([postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String            @id @default(uuid())
  journalEntryId String
  accountType    LedgerAccountType
  memberId       String?
  accountRefType String? // SAVINGS, LOAN, EAJO_MEMBER, WALLET, etc.
  accountRefId   String?
  currency       String            @default("NGN")
  debit          Decimal           @default(0) @db.Decimal(15, 2)
  credit         Decimal           @default(0) @db.Decimal(15, 2)
  createdAt      DateTime          @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  member       User?        @relation("JournalLineMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@index([accountType, accountRefId])
  @@index([memberId, accountType])
  @@index([journalEntryId])
  @@map("journal_lines")
}

model WalletWithdrawal {
  id               String                 @id @default(uuid())
  withdrawalNumber String                 @unique
  memberId         String
  amount           Decimal                @db.Decimal(15, 2)
  bankAccountId    String
  status           WalletWithdrawalStatus @default(REQUESTED)
  requestedAt      DateTime               @default(now())
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  idempotencyKey   String                 @unique

  member      User        @relation("MemberWalletWithdrawals", fields: [memberId], references: [id], onDelete: Restrict)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("WalletWithdrawalApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@map("wallet_withdrawals")
}

model AuditEvent {
  id               String    @id @default(uuid())
  actorId          String?
  actorRole        UserRole?
  affectedUserId   String?
  action           String
  entityType       String
  entityId         String?
  outcome          String    @default("SUCCESS")
  metadata         Json?
  beforeState      Json?
  afterState       Json?
  correlationId    String?
  ipHash           String?
  userAgent        String?
  isSingleOperator Boolean   @default(false)
  createdAt        DateTime  @default(now())
  timestamp        DateTime  @default(now())

  actor        User? @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: Cascade)
  affectedUser User? @relation("UserAffectedAuditEvents", fields: [affectedUserId], references: [id], onDelete: Cascade)

  @@index([affectedUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([timestamp])
  @@map("audit_events")
}

// ---------------------------------------------------------
// PR P2-07: Payment Submissions, Payments, Allocations & Disbursements (§2.10, §2.11, §2.12)
// ---------------------------------------------------------

enum SubmissionPurpose {
  SAVINGS_FIRST_DEPOSIT
  SAVINGS_PERIOD
  SAVINGS_DEPOSIT
  LOAN_REPAYMENT
  LOAN_SETTLEMENT
  EAJO_CONTRIBUTION
  WALLET_TOPUP
  FEE
}

enum PaymentSubmissionStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  CONFIRMED
  REVERSED
}

enum PaymentSource {
  RECEIPT
  WALLET
  RECOVERY
  SUSPENSE_MATCH
}

enum AllocationTargetType {
  SAVINGS
  LOAN
  EAJO
  WALLET
  FEE
}

enum PaymentComponentType {
  PENALTY
  INTEREST
  PRINCIPAL
  CONTRIBUTION
  WALLET_TOPUP
  FEE
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

enum DisbursementPurpose {
  LOAN_DISBURSEMENT
  SAVINGS_PAYOUT
  EAJO_PAYOUT
  WALLET_WITHDRAWAL
  MEMBER_SETTLEMENT
}

enum DisbursementStatus {
  REQUESTED
  APPROVED
  PAID
  FAILED
  CANCELLED
}

enum FeeType {
  LOAN_APPLICATION
  MEMBERSHIP
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
}

model PaymentSubmission {
  id                     String                  @id @default(uuid())
  submissionNumber       String                  @unique
  memberId               String
  purpose                SubmissionPurpose?
  receivingBankAccountId String?
  claimedAmount          Decimal                 @db.Decimal(15, 2)
  paidOn                 DateTime                @db.Date
  bankReference          String?
  payerAccountName       String?
  receiptFileId          String?
  fileHash               String?
  narration              String?
  status                 PaymentSubmissionStatus @default(SUBMITTED)
  rejectionReason        String?
  resubmissionOfId       String?
  submittedAt            DateTime                @default(now())
  confirmedAt            DateTime?
  confirmedById          String?
  valueDate              DateTime?               @db.Date

  member               User                @relation("MemberPaymentSubmissions", fields: [memberId], references: [id], onDelete: Restrict)
  receivingBankAccount SocietyBankAccount? @relation(fields: [receivingBankAccountId], references: [id], onDelete: Restrict)
  receiptFile          StoredFile?         @relation("ReceiptStoredFile", fields: [receiptFileId], references: [id], onDelete: Restrict)
  confirmedBy          User?               @relation("PaymentSubmissionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  resubmissionOf       PaymentSubmission?  @relation("SubmissionResubmissions", fields: [resubmissionOfId], references: [id], onDelete: Restrict)
  resubmissions        PaymentSubmission[] @relation("SubmissionResubmissions")
  targets              SubmissionTarget[]
  payment              Payment?

  @@index([memberId, status])
  @@index([paidOn])
  @@index([fileHash])
  @@index([bankReference, claimedAmount, paidOn])
  @@map("payment_submissions")
}

model SubmissionTarget {
  id              String               @id @default(uuid())
  submissionId    String
  targetType      AllocationTargetType
  targetId        String
  targetPeriodId  String?
  requestedAmount Decimal              @db.Decimal(15, 2)

  submission PaymentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([targetType, targetId])
  @@map("submission_targets")
}

model Payment {
  id                   String        @id @default(uuid())
  paymentNumber        String        @unique
  source               PaymentSource @default(RECEIPT)
  submissionId         String?       @unique
  memberId             String
  totalConfirmedAmount Decimal       @db.Decimal(15, 2)
  valueDate            DateTime      @db.Date
  status               PaymentStatus @default(CONFIRMED)
  confirmedAt          DateTime      @default(now())
  confirmedById        String
  reversedAt           DateTime?
  reversedById         String?
  reversalReason       String?
  idempotencyKey       String        @unique

  submission  PaymentSubmission?  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  member      User                @relation("MemberPayments", fields: [memberId], references: [id], onDelete: Restrict)
  confirmedBy User                @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  reversedBy  User?               @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([memberId, valueDate])
  @@index([valueDate])
  @@index([status])
  @@map("payments")
}

model PaymentAllocation {
  id             String               @id @default(uuid())
  paymentId      String
  targetType     AllocationTargetType
  targetId       String
  periodId       String?
  componentType  PaymentComponentType
  amount         Decimal              @db.Decimal(15, 2)
  status         AllocationStatus     @default(ACTIVE)
  reversedAt     DateTime?
  journalEntryId String?
  createdAt      DateTime             @default(now())

  payment        Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  feeAssessments FeeAssessment[]

  @@index([paymentId])
  @@index([targetType, targetId, periodId])
  @@index([status])
  @@map("payment_allocations")
}

model Disbursement {
  id                 String              @id @default(uuid())
  disbursementNumber String              @unique
  recipientUserId    String
  purpose            DisbursementPurpose
  amount             Decimal             @db.Decimal(15, 2)
  bankAccountId      String
  bankReference      String?
  valueDate          DateTime            @db.Date
  status             DisbursementStatus  @default(REQUESTED)
  requestedById      String
  approvedById       String?
  disbursedById      String?
  disbursedAt        DateTime?
  rejectionReason    String?
  journalEntryId     String?
  idempotencyKey     String              @unique
  createdAt          DateTime            @default(now())

  recipient    User          @relation("DisbursementRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  requestedBy  User          @relation("DisbursementRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy   User?         @relation("DisbursementApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  disbursedBy  User?         @relation("DisbursementDisburser", fields: [disbursedById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, status])
  @@index([valueDate])
  @@map("disbursements")
}

model FeeAssessment {
  id                  String    @id @default(uuid())
  memberId            String
  feeType             FeeType
  targetId            String
  amount              Decimal   @db.Decimal(15, 2)
  status              FeeStatus @default(PENDING)
  paymentAllocationId String?
  assessedAt          DateTime  @default(now())

  member     User               @relation("MemberFeeAssessments", fields: [memberId], references: [id], onDelete: Restrict)
  allocation PaymentAllocation? @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@index([feeType, targetId])
  @@map("fee_assessments")
}
