generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum UserDeactivationReason {
  ADMIN_ACTION
  EXITED
  DECEASED
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum Relationship {
  SPOUSE
  SIBLING
  PARENT
  CHILD
  FRIEND
  COLLEAGUE
  NEIGHBOR
  ACQUAINTANCE
  RELATIVE
  EMPLOYER
  EMPLOYEE
  OTHER
}

enum MembershipInterest {
  E_AJO
  SAVINGS
  LOAN
}

enum Assumptions {
  HAS_SMART_PHONE
  HAS_INTEGRITY
  IS_TRUSTWORTHY
  HAS_INTERNET_ACCESS
  HAS_EMAIL
  HAS_WHATS_APP
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED // For yearly renewal tracking
}

enum MembershipTier {
  MEMBER // Loan only
  SILVER_MEMBER // Ajo participant
  GOLD_MEMBER // Savings participant
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationEventType {
  // System-triggered
  MEMBER_REGISTERED
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  MEMBERSHIP_EXPIRED
  PASSWORD_SET
  // Admin-triggered
  CUSTOM
}

// E-AJO ENUMS
enum EAjoDuration {
  FOUR_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum EAjoFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum EAjoStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EAjoMemberStatus {
  PENDING // Member applied, awaiting admin approval
  APPROVED // Admin approved the slot assignment
  REJECTED // Admin rejected the application
  ACTIVE // Group is running and member is contributing
  COMPLETED // Member received their payout
  CANCELLED // Member or admin cancelled
}

// SAVINGS ENUMS
enum SavingsType {
  FIXED // UPFRONT - bulk amount once
  REGULAR // Regular interval savings
  STAGGERED // Any amount, any time
}

enum SavingsFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ONCE // For FIXED savings
}

enum SavingsMaturity {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum SavingsStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  MATURED
  WITHDRAWN
  EARLY_WITHDRAWAL // Withdrawn before maturity (no interest)
}

// LOAN ENUMS
enum LoanStatus {
  PENDING
  APPROVED
  ACCEPTED
  DECLINED
  REJECTED
  DISBURSED
  ACTIVE
  COMPLETED
  DEFAULTED
  OVERDUE
}

enum PaymentPeriodStatus {
  PENDING
  IN_REVIEW
  ONGOING
  COMPLETED
  REJECTED
  OVERDUE
  WAIVED
}

// enum LoanApplicantType {
//   MEMBER_WITH_SAVINGS
//   MEMBER_WITHOUT_SAVINGS
//   NON_MEMBER
// }

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST_CREDIT
  PENALTY
  FEE_DEDUCTION
  REFUND
}

// ============================================
// CORE USER MODELS
// ============================================

enum PasswordSetupTokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

enum AdminPermission {
  MEMBERS_READ
  MEMBERS_CREATE
  MEMBERS_APPROVE
  PROFILE_CHANGES_REVIEW
  SOCIETY_SETTINGS_MANAGE
  SAVINGS_READ
  SAVINGS_MANAGE
  SAVINGS_PAYMENTS_REVIEW
  LOANS_READ
  LOANS_REVIEW
  LOANS_DISBURSE
  LOAN_SETTINGS_MANAGE
  GUARANTEES_REVIEW
  EAJO_READ
  EAJO_MANAGE
  EAJO_PAYMENTS_REVIEW
  EAJO_PAYOUTS_MANAGE
  TRANSACTIONS_READ
  TRANSACTIONS_REVIEW
  PAYMENTS_REVERSE
  WALLET_MANAGE
  WALLET_WITHDRAWALS_REVIEW
  RECOVERY_MANAGE
  RECOVERY_EXECUTE
  PENALTY_WAIVE
  RECONCILIATION_MANAGE
  SETTLEMENTS_MANAGE
  POLICY_NOTICES_MANAGE
  NOTIFICATIONS_MANAGE
  AUDIT_READ
  STAFF_MANAGE
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  username               String         @unique @default(uuid())
  name                   String
  passwordHash           String? // Optional: null until user sets password
  photoUrl               String?
  role                   UserRole       @default(USER)
  emailVerified          DateTime? // For email verification
  hasSetPassword         Boolean        @default(false) // Track if user has activated account
  sessionVersion         Int            @default(0)
  lastLoginAt            DateTime?
  mfaEnabled             Boolean        @default(false)
  mfaSecret              String? // AES-256-GCM encrypted TOTP secret
  mfaBackupCodes         Json? // Array of { hash: string, usedAt?: string }
  mfaEnrolledAt          DateTime?
  mfaResetAt             DateTime?
  lockedUntil            DateTime?
  lockoutCount           Int            @default(0)
  isActive               Boolean                 @default(true)
  deactivatedAt          DateTime?
  deactivatedById        String?
  deactivationReason     UserDeactivationReason?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  receivedNotifications  Notification[]          @relation("ReceivedNotifications")
  triggeredNotifications Notification[]          @relation("TriggeredNotifications")

  // Relations
  deactivatedBy          User?                  @relation("UserDeactivations", fields: [deactivatedById], references: [id], onDelete: Restrict)
  deactivatedUsers       User[]                 @relation("UserDeactivations")
  privacyConsents        PrivacyConsent[]
  societyBankAccountsCreated SocietyBankAccount[] @relation("SocietyBankAccountCreator")
  journalEntriesPosted   JournalEntry[]         @relation("JournalEntryPoster")
  journalLines           JournalLine[]          @relation("JournalLineMember")
  walletWithdrawals      WalletWithdrawal[]     @relation("MemberWalletWithdrawals")
  walletWithdrawalsApproved WalletWithdrawal[]  @relation("WalletWithdrawalApprover")
  auditEvents            AuditEvent[]           @relation("UserAuditEvents")
  accounts                Account[]
  sessions                Session[]
  userSessions            UserSession[]
  loginAttempts           LoginAttempt[]
  passwordSetupTokens     PasswordSetupToken[]
  adminPermissionGrants   AdminPermissionGrant[] @relation("AdminPermissionGrants")
  createdPermissionGrants AdminPermissionGrant[] @relation("PermissionGrantCreator")
  uploadedFiles           StoredFile[]           @relation("UploadedFiles")
  ownedFiles              StoredFile[]           @relation("OwnedFiles")
  userInfo                UserInfo?
  bankAccounts            BankAccount[]
  nextOfKin               NextOfKin?
  membership              Membership?
  eAjo                    EAjo[]
  eAjoGroups              EAjoGroup[]            @relation("EAjoGroupCreator")
  eAjoMembers             EAjoMember[]
  savings                 Savings[]
  loans                   Loan[]
  transactions            Transaction[]          @relation("TransactionOwner")
  transactionsRecorded    Transaction[]          @relation("TransactionRecorder")
  transactionsProcessed   Transaction[]          @relation("TransactionProcessor")
  createdSavingsProducts  SavingsProduct[]       @relation("SavingsProductCreator")

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordSetupToken {
  id            String                    @id @default(uuid())
  userId        String
  tokenHash     String                    @unique
  purpose       PasswordSetupTokenPurpose @default(SET_PASSWORD)
  expiresAt     DateTime
  usedAt        DateTime?
  requestedIp   String?
  createdById   String?
  createdAt     DateTime                  @default(now())
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([requestedIp, createdAt])
  @@index([expiresAt])
  @@map("password_setup_tokens")
}

model AdminPermissionGrant {
  id          String          @id @default(uuid())
  adminUserId String
  permission  AdminPermission
  grantedById String
  createdAt   DateTime        @default(now())
  admin       User            @relation("AdminPermissionGrants", fields: [adminUserId], references: [id], onDelete: Restrict)
  grantedBy   User            @relation("PermissionGrantCreator", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([adminUserId, permission])
  @@index([grantedById])
  @@map("admin_permission_grants")
}

model StoredFile {
  id               String   @id @default(uuid())
  publicId         String   @unique
  secureUrl        String
  purpose          String
  resourceType     String   @default("image")
  deliveryType     String   @default("authenticated")
  format           String
  contentType      String
  sizeBytes        Int
  originalFilename String?
  uploadedById     String
  ownerUserId      String?
  associatedType   String?
  associatedId     String?
  createdAt        DateTime @default(now())

  uploadedBy       User     @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Restrict)
  ownerUser        User?    @relation("OwnedFiles", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([uploadedById])
  @@index([associatedType, associatedId])
  @@map("stored_files")
}

model PrivacyConsent {
  id            String   @id @default(uuid())
  userId        String
  noticeVersion String
  acceptedAt    DateTime @default(now())
  ipHash        String?
  userAgent     String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, noticeVersion])
  @@index([userId])
  @@map("privacy_consents")
}

model SocietyBankAccount {
  id            String   @id @default(uuid())
  bankCode      String?
  bankName      String
  accountNumber String
  accountName   String
  isActive      Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdByUser User     @relation("SocietyBankAccountCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@map("society_bank_accounts")
}

model UserInfo {
  id          String    @id @default(uuid())
  address     String?
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  occupation  String?
  phoneNumber String?   @unique
  userId      String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_info")
}

model BankAccount {
  id            String        @id @default(uuid())
  bankCode      String?
  accountNumber String
  accountName   String
  bankName      String
  userId        String
  isPrimary     Boolean       @default(false) // Mark primary account
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions  Transaction[]
  walletWithdrawals WalletWithdrawal[]

  @@unique([userId, bankCode, accountNumber])
  @@index([bankCode, accountNumber])
  @@index([userId])
  @@map("bank_accounts")
}

model NextOfKin {
  id            String       @id @default(uuid())
  name          String
  phoneNumber   String
  relationship  Relationship
  bankName      String
  accountNumber String
  accountName   String
  occupation    String
  address       String
  userId        String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("next_of_kins")
}

model Membership {
  id                  String               @id @default(uuid())
  sourceOfIncome      String[]
  interests           MembershipInterest[]
  referralName        String?
  referralPhoneNumber String?
  membershipNumber    String?              @unique
  assumptions         Assumptions[]
  tier                MembershipTier       @default(MEMBER)
  status              MembershipStatus     @default(PENDING)
  approvedAt          DateTime?
  approvedBy          String?
  rejectionReason     String?
  membershipFee       Decimal              @default(0) @db.Decimal(15, 2)
  renewalFee          Decimal              @default(0) @db.Decimal(15, 2) // Currently 0, future: 2000
  expiryDate          DateTime?            @db.Date // For yearly renewal
  lastRenewalDate     DateTime?            @db.Date
  userId              String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("memberships")
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "welcome_email"
  subject     String
  htmlBody    String // HTML with {{variable}} placeholders
  variables   String[] // list of variable names e.g. ["memberName", "date"]
  description String?
  isSystem    Boolean  @default(false) // system templates can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications Notification[]

  @@map("notification_templates")
}

model Notification {
  id      String                @id @default(uuid())
  type    NotificationEventType
  channel NotificationChannel
  status  NotificationStatus    @default(PENDING)

  // Who sent it
  triggeredBy String? // userId of admin, null = system

  // Who receives it
  recipientId String // userId

  // Content
  subject    String?
  body       String // final rendered HTML or text
  templateId String?
  variables  Json? // snapshot of variables used

  // Metadata
  externalId  String? // e.g. Resend message ID
  errorMsg    String?
  readAt      DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User                  @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  triggerer User?                 @relation("TriggeredNotifications", fields: [triggeredBy], references: [id])
  template  NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@map("notifications")
}

// ============================================
// E-AJO (CONTRIBUTION) MODELS
// ============================================

model EAjo {
  id                   String        @id @default(uuid())
  userId               String
  contributionAmount   Decimal       @db.Decimal(15, 2) // Amount to save per period (e.g., 10k)
  totalParticipants    Int // Duration in months (4, 6, or 12)
  duration             EAjoDuration
  frequency            EAjoFrequency
  payoutPosition       Int // Which position user wants to collect (1-4, 1-6, or 1-12)
  feePercentage        Decimal       @db.Decimal(7, 4) // Calculated based on position and duration
  feeAmount            Decimal       @db.Decimal(15, 2) // Actual fee to be deducted
  totalExpectedPayout  Decimal       @db.Decimal(15, 2) // contributionAmount * totalParticipants
  netPayoutAmount      Decimal       @db.Decimal(15, 2) // totalExpectedPayout - feeAmount
  guarantorName        String
  guarantorPhoneNumber String
  bankName             String
  accountNumber        String
  accountName          String
  currentBalance       Decimal       @default(0) @db.Decimal(15, 2)
  totalContributed     Decimal       @default(0) @db.Decimal(15, 2)
  hasReceivedPayout    Boolean       @default(false)
  payoutDate           DateTime?     @db.Date
  startDate            DateTime?     @db.Date
  endDate              DateTime?     @db.Date
  isAnonymousRequest   Boolean       @default(false) // True if submitted via public form with membership ID
  status               EAjoStatus    @default(PENDING)
  approvedAt           DateTime?
  approvedBy           String?
  rejectionReason      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("e_ajo")
}

// ============================================
// E-AJO GROUP MODELS (Admin-Created)
// ============================================

model EAjoGroup {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  contributionAmount Decimal       @db.Decimal(15, 2)
  frequency          EAjoFrequency
  duration           EAjoDuration
  totalSlots         Int // Number of positions (4, 6, or 12)
  filledSlots        Int           @default(0)
  status             EAjoStatus    @default(PENDING)
  startDate          DateTime?     @db.Date
  endDate            DateTime?     @db.Date
  createdBy          String // Admin User ID
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  createdByUser User         @relation("EAjoGroupCreator", fields: [createdBy], references: [id])
  members       EAjoMember[]

  @@index([status])
  @@map("e_ajo_groups")
}

model EAjoMember {
  id                   String           @id @default(uuid())
  groupId              String
  userId               String
  payoutPosition       Int // Requested/assigned slot number (1 to totalSlots)
  feePercentage        Decimal          @default(0) @db.Decimal(7, 4)
  feeAmount            Decimal          @default(0) @db.Decimal(15, 2)
  totalExpectedPayout  Decimal          @default(0) @db.Decimal(15, 2)
  netPayoutAmount      Decimal          @default(0) @db.Decimal(15, 2)
  guarantorName        String
  guarantorPhoneNumber String
  bankName             String
  accountNumber        String
  accountName          String
  currentBalance       Decimal          @default(0) @db.Decimal(15, 2)
  totalContributed     Decimal          @default(0) @db.Decimal(15, 2)
  hasReceivedPayout    Boolean          @default(false)
  payoutDate           DateTime?        @db.Date
  status               EAjoMemberStatus @default(PENDING)
  approvedAt           DateTime?
  approvedBy           String? // Admin User ID
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  group               EAjoGroup                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions        Transaction[]
  contributionPeriods EAjoContributionPeriod[]

  @@unique([groupId, payoutPosition]) // One member per slot per group
  @@unique([groupId, userId]) // One application per user per group
  @@index([userId])
  @@index([groupId])
  @@map("e_ajo_members")
}

model EAjoContributionPeriod {
  id               String                 @id @default(uuid())
  eajoMemberId     String
  periodNumber     Int
  dueDate          DateTime               @db.Date
  contributionDue  Decimal                @db.Decimal(15, 2)
  contributionPaid Decimal                @default(0) @db.Decimal(15, 2)
  penaltyAssessed  Decimal                @default(0) @db.Decimal(15, 2)
  penaltyPaid      Decimal                @default(0) @db.Decimal(15, 2)
  penaltyWaived    Decimal                @default(0) @db.Decimal(15, 2)
  status           PaymentPeriodStatus    @default(PENDING)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  eajoMember       EAjoMember             @relation(fields: [eajoMemberId], references: [id], onDelete: Restrict)
  penalties        EAjoPenaltyAccrual[]

  @@unique([eajoMemberId, periodNumber])
  @@index([status, dueDate])
  @@map("e_ajo_contribution_periods")
}

model EAjoPenaltyAccrual {
  id                       String                 @id @default(uuid())
  eajoContributionPeriodId String
  penaltyDate              DateTime               @db.Date
  amount                   Decimal                @db.Decimal(15, 2)
  reversedAt               DateTime?
  reversalReason           String?
  journalEntryId           String?
  createdAt                DateTime               @default(now())

  period                   EAjoContributionPeriod @relation(fields: [eajoContributionPeriodId], references: [id], onDelete: Restrict)

  @@unique([eajoContributionPeriodId, penaltyDate])
  @@map("e_ajo_penalty_accruals")
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
  DISBURSED
  FAILED
}

enum TransactionCategory {
  AJO_CONTRIBUTION
  AJO_PAYOUT
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  WALLET_TOPUP
  WALLET_WITHDRAWAL
  INTEREST
  PENALTY
  FEE
}

model AjoFeeConfig {
  id             String   @id @default(uuid())
  durationMonths Int // 4, 6, 12
  pickPosition   Int // 1 to N
  feePercentage  Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([durationMonths, pickPosition])
  @@map("ajo_fee_configs")
}

model Transaction {
  id       String              @id @default(uuid())
  userId   String
  amount   Decimal             @db.Decimal(15, 2)
  category TransactionCategory
  type     TransactionType
  status   TransactionStatus   @default(PENDING)

  // Reference IDs to specific packages
  eAjoId       String?
  eAjoMemberId String? // Reference to new EAjoMember model
  savingsId    String?
  loanId       String?

  // Offline/Manual payment tracking
  receiptUrl      String?
  rejectionReason String?
  referenceNumber String?
  notes           String?

  // Account routing (for money-out)
  bankAccountId String?

  // Audit metadata
  recordedBy  String // User ID who uploaded/recorded (usually owner or admin)
  processedBy String? // User ID of admin who approved/confirmed/disbursed

  transactionDate DateTime  @default(now())
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Restrict)
  recorder    User         @relation("TransactionRecorder", fields: [recordedBy], references: [id])
  processor   User?        @relation("TransactionProcessor", fields: [processedBy], references: [id])
  eAjo        EAjo?        @relation(fields: [eAjoId], references: [id], onDelete: Restrict)
  eAjoMember  EAjoMember?  @relation(fields: [eAjoMemberId], references: [id], onDelete: Restrict)
  savings     Savings?     @relation(fields: [savingsId], references: [id], onDelete: Restrict)
  loan        Loan?        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("transactions")
}

// ============================================
// SAVINGS MODELS
// ============================================

model SavingsProduct {
  id                   String      @id @default(uuid())
  type                 SavingsType // (FIXED, REGULAR, STAGGERED)
  title                String
  description          String
  rates                String // e.g. "12% (6 Months) / 36% (1 Year)"
  badge                String // e.g. "High Yield"
  icon                 String // Name of the lucide icon, e.g. "Lock", "PiggyBank"
  interestRate1Month   Decimal?    @db.Decimal(7, 4)
  interestRate3Months  Decimal?    @db.Decimal(7, 4)
  interestRate6Months  Decimal?    @db.Decimal(7, 4)
  interestRate12Months Decimal?    @db.Decimal(7, 4)
  isActive             Boolean     @default(true)
  createdBy            String // Admin userId
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdByUser User      @relation("SavingsProductCreator", fields: [createdBy], references: [id])
  savings       Savings[]

  @@map("savings_products")
}

model Savings {
  id                     String           @id @default(uuid())
  userId                 String
  productId              String?
  savingsType            SavingsType
  targetAmount           Decimal?         @db.Decimal(15, 2) // For FIXED, the bulk amount; For REGULAR, amount per period
  frequency              SavingsFrequency
  maturity               SavingsMaturity
  interestRate           Decimal          @db.Decimal(7, 4) // Snapshotted simple interest rate
  bankName               String
  accountNumber          String
  accountName            String
  currentBalance         Decimal          @default(0) @db.Decimal(15, 2)
  accruedInterest        Decimal          @default(0) @db.Decimal(15, 2)
  totalDeposited         Decimal          @default(0) @db.Decimal(15, 2)
  expectedMaturityAmount Decimal?         @db.Decimal(15, 2)
  isAnonymousRequest     Boolean          @default(false) // True if submitted via public form with membership ID
  status                 SavingsStatus    @default(PENDING)
  approvedAt             DateTime?
  approvedBy             String?
  rejectionReason        String?
  startDate              DateTime?        @db.Date
  maturityDate           DateTime?        @db.Date
  earlyWithdrawal        Boolean          @default(false) // If true, no interest
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  product      SavingsProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  periods      SavingsPeriod[]

  @@index([userId])
  @@index([status])
  @@index([productId])
  @@map("savings")
}

model SavingsPeriod {
  id                String              @id @default(uuid())
  savingsId         String
  periodNumber      Int
  dueDate           DateTime            @db.Date
  amountDue         Decimal             @db.Decimal(15, 2)
  amountPaid        Decimal             @default(0) @db.Decimal(15, 2)
  status            PaymentPeriodStatus @default(PENDING)
  interestForfeited Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  savings           Savings             @relation(fields: [savingsId], references: [id], onDelete: Restrict)

  @@unique([savingsId, periodNumber])
  @@index([status, dueDate])
  @@map("savings_periods")
}

// Deprecated savings transactions removed

// ============================================
// LOAN MODELS
// ============================================

model Loan {
  id                   String     @id @default(uuid())
  userId               String
  // applicantType        LoanApplicantType
  requestedAmount      Decimal    @db.Decimal(15, 2)
  approvedAmount       Decimal?   @db.Decimal(15, 2)
  interestRate         Decimal    @db.Decimal(7, 4) // Flat monthly percentage on original principal
  duration             Int // In months (max 6)
  purpose              String
  guarantorId          String? // Another User ID (must be Crystal member)
  guarantorName        String?
  guarantorPhoneNumber String?
  collateralDetails    String? // For non-members
  applicationFee       Decimal    @default(0) @db.Decimal(15, 2)
  outstandingBalance   Decimal    @default(0) @db.Decimal(15, 2)
  totalRepaid          Decimal    @default(0) @db.Decimal(15, 2)
  defaultPenalty       Decimal    @default(0) @db.Decimal(15, 2)
  gracePeriodDays      Int        @default(7)
  isAnonymousRequest   Boolean    @default(false) // True if submitted via public form with membership ID
  status               LoanStatus @default(PENDING)
  requestedAt          DateTime   @default(now())
  approvedAt           DateTime?
  approvedBy           String?
  disbursedAt          DateTime?
  repaymentStartDate   DateTime?  @db.Date
  repaymentEndDate     DateTime?  @db.Date
  actualRepaymentDate  DateTime?  @db.Date
  rejectionReason      String?
  isDefaulted          Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  // guarantor  User?            @relation("LoanGuarantor", fields: [guarantorId], references: [id])
  transactions Transaction[]
  instalments  LoanInstalment[]

  @@index([userId])
  @@index([guarantorId])
  @@index([status])
  @@map("loans")
}

model LoanInstalment {
  id                   String               @id @default(uuid())
  loanId               String
  instalmentNumber     Int
  dueDate              DateTime             @db.Date
  principalDue         Decimal              @db.Decimal(15, 2)
  interestDue          Decimal              @db.Decimal(15, 2)
  principalPaid        Decimal              @default(0) @db.Decimal(15, 2)
  interestPaid         Decimal              @default(0) @db.Decimal(15, 2)
  penaltyAssessed      Decimal              @default(0) @db.Decimal(15, 2) // net of value-date reversals
  penaltyPaid          Decimal              @default(0) @db.Decimal(15, 2)
  penaltyWaived        Decimal              @default(0) @db.Decimal(15, 2)
  interestRecognisedAt DateTime?
  status               PaymentPeriodStatus  @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  loan                 Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  penalties            LoanPenaltyAccrual[]

  @@unique([loanId, instalmentNumber])
  @@index([status, dueDate])
  @@map("loan_instalments")
}

model LoanPenaltyAccrual {
  id               String         @id @default(uuid())
  loanInstalmentId String
  penaltyDate      DateTime       @db.Date
  amount           Decimal        @db.Decimal(15, 2)
  reversedAt       DateTime?
  reversalReason   String?
  journalEntryId   String?
  createdAt        DateTime       @default(now())

  instalment       LoanInstalment @relation(fields: [loanInstalmentId], references: [id], onDelete: Restrict)

  @@unique([loanInstalmentId, penaltyDate])
  @@map("loan_penalty_accruals")
}

model LoanSettings {
  id           String   @id @default("global") // singleton
  interestRate Decimal  @default(5.0) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}


model UserSession {
  id             String    @id @default(uuid())
  userId         String
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  idleExpiresAt  DateTime
  userAgentLabel String?
  ipHash         String?
  mfaVerifiedAt  DateTime?
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  emailHash String
  ipHash    String
  succeeded Boolean
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

model SocietySetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("society_settings")
}

// ============================================
// FINANCIAL JOURNAL & LEDGER MODELS (PR P2-02, §2.12)
// ============================================

enum LedgerAccountType {
  COOPERATIVE_CASH
  SUSPENSE_UNIDENTIFIED
  MEMBER_WALLET_LIABILITY
  SAVINGS_PRINCIPAL_LIABILITY
  SAVINGS_INTEREST_PAYABLE
  SAVINGS_INTEREST_EXPENSE
  LOAN_RECEIVABLE_PRINCIPAL
  LOAN_INTEREST_RECEIVABLE
  LOAN_INTEREST_INCOME
  LOAN_PENALTY_RECEIVABLE
  EAJO_CONTRIBUTION_LIABILITY
  EAJO_ADVANCE_RECEIVABLE
  EAJO_PENALTY_RECEIVABLE
  EAJO_EARLY_SLOT_INCOME
  PENALTY_INCOME
  FEE_INCOME
  WAIVER_EXPENSE
  BAD_DEBT_EXPENSE
  MEMBER_SETTLEMENT_PAYABLE
  REVERSAL_SHORTFALL_RECEIVABLE
  OPENING_BALANCE_EQUITY
  ADJUSTMENT
}

enum WalletWithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
  FAILED
}

model JournalEntry {
  id             String        @id @default(uuid())
  sourceType     String        // e.g. TRANSACTION, PAYMENT, DISBURSEMENT, RECOVERY, ACCRUAL
  sourceId       String
  idempotencyKey String        @unique
  description    String
  effectiveDate  DateTime      @db.Date
  postedAt       DateTime      @default(now())
  postedById     String?
  reversalOfId   String?       @unique
  reason         String?
  createdAt      DateTime      @default(now())

  postedBy   User?         @relation("JournalEntryPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  @@index([sourceType, sourceId])
  @@index([effectiveDate])
  @@index([postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String            @id @default(uuid())
  journalEntryId String
  accountType    LedgerAccountType
  memberId       String?
  accountRefType String?           // SAVINGS, LOAN, EAJO_MEMBER, WALLET, etc.
  accountRefId   String?
  currency       String            @default("NGN")
  debit          Decimal           @default(0) @db.Decimal(15, 2)
  credit         Decimal           @default(0) @db.Decimal(15, 2)
  createdAt      DateTime          @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  member       User?        @relation("JournalLineMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@index([accountType, accountRefId])
  @@index([memberId, accountType])
  @@index([journalEntryId])
  @@map("journal_lines")
}

model WalletWithdrawal {
  id               String                 @id @default(uuid())
  withdrawalNumber String                 @unique
  memberId         String
  amount           Decimal                @db.Decimal(15, 2)
  bankAccountId    String
  status           WalletWithdrawalStatus @default(REQUESTED)
  requestedAt      DateTime               @default(now())
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  idempotencyKey   String                 @unique

  member        User        @relation("MemberWalletWithdrawals", fields: [memberId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  approvedBy    User?       @relation("WalletWithdrawalApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@map("wallet_withdrawals")
}

model AuditEvent {
  id               String    @id @default(uuid())
  actorId          String?
  actorRole        UserRole?
  action           String
  entityType       String
  entityId         String
  beforeState      Json?
  afterState       Json?
  metadata         Json?
  ipHash           String?
  userAgent        String?
  isSingleOperator Boolean   @default(false)
  timestamp        DateTime  @default(now())

  actor User? @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, timestamp])
  @@index([timestamp])
  @@map("audit_events")
}
