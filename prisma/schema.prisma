  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  idleExpiresAt  DateTime
  userAgentLabel String?
  ipHash         String?
  mfaVerifiedAt  DateTime?
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

