# ==============================================================================
# Crystal Kairos — Environment Configuration Template
# ==============================================================================

NODE_ENV="development"
TZ="Africa/Lagos"

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crystal_kairos?schema=public"

# Auth.js / NextAuth configuration
AUTH_SECRET="generate-a-secure-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MFA encryption key (32-byte base64 encoded string: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=""

# Cloudinary storage configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_BASE_FOLDER="crystal-kairos"

# Transactional email via Resend (PR P4-01)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM_ADDRESS="notifications@crystalkairos.com"
EMAIL_FROM_NAME="Crystal Kairos"
EMAIL_REPLY_TO="support@crystalkairos.com"

# Optional signed webhook secret from Resend dashboard
RESEND_WEBHOOK_SECRET=""

# Administrative notifications
ADMIN_EMAIL="admin@crystalkairos.com"

# Paystack integration (leave unset in development to use mock bank verification)
# PAYSTACK_SECRET_KEY=""
